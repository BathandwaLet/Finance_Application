@model IEnumerable<Finance_Application.Models.Income>

<h2>My Income</h2>

<div class="container">
    <table class="table table-bordered">
        <thead class="table-light">
        <tr>
            <th>Description</th>
            <th>Amount</th>
            <th>Category</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Description</td>
                <td>@item.Amount R</td>
                <td>@item.Category</td>
                <td>@item.Date.ToString("yyyy-MM-dd")</td>
                <td>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
    <a asp-controller="Income" asp-action="Create">
        <button class="btn btn-primary">Add Income</button>
    </a>
</div>

<h2>Income Overview </h2>
<div>
    <canvas  style="max-height: 450px; max-width: 450px"  id="myChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  const ctx = document.getElementById('myChart');

  fetch('Income/GetChart/')
      .then(response => response.json())
      .then(data => {
          new Chart(ctx, {
              type: 'pie', 
              data: {
                  labels: data.map(d => d.category),
                  datasets: [{
                      data: data.map(d => d.total),
                  }]
              },

          }); 
      })
  
</script>